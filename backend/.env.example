DATABASE_URL=postgresql+psycopg2://biodiversity:biodiversity@localhost:5432/biodiversity_db

# development | test | production. Outside development/test the app refuses to start
# with a weak JWT_SECRET_KEY, and /docs is hidden in production.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# First admin account (created only if no user has this email). Leave the password
# empty to have a random one generated and printed once in the server log.
INITIAL_ADMIN_EMAIL=admin@biodiversity.local
INITIAL_ADMIN_PASSWORD=

IUCN_API_TOKEN=
# Contact address sent to GBIF / Wikidata in the User-Agent (they ask for one).
PROVIDER_CONTACT=

# Behind a reverse proxy: the proxy's IP(s), so the login rate limit sees real
# client IPs (read by uvicorn). Use "*" only if the API is reachable solely through it.
# FORWARDED_ALLOW_IPS=127.0.0.1
