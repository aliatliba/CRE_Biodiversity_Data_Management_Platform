# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (docker-compose sets DATABASE_URL itself for the api/migrations
# services; only needed here if you run the app outside docker-compose) ---
DATABASE_URL=postgresql+psycopg2://biodiversity:biodiversity@db:5432/biodiversity_db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Third-party integrations ---
IUCN_API_TOKEN=your-iucn-api-token-here

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend integration ---
# Comma-separated origins allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Used by docker-compose when building the frontend image.
VITE_API_URL=http://localhost:8000
